Notebook[{
Cell["Checks of the derivations", "Title"],
Cell["The Mathematica counterpart of the SymPy scripts in this folder (partition_prior.py and triggered_report.py). Each check prints PASS or FAIL. Evaluate the notebook from the top (Evaluation > Evaluate Notebook).", "Text"],
Cell["check[name_, ok_] := Print[If[TrueQ[ok], \"PASS  \", \"FAIL  \"], name]", "Input"],
Cell["The prior on a partition", "Section"],
Cell["Appendix, \"Quantities which change at unknown times\". The joint prior is pi(p, P) ∝ Beta(p | a, b) p^K (1 - p)^(T - 1 - K) 1{P in A_l}, with K = K(P) the number of changes of P. Below, m = K and n = T - 1 - K.", "Text"],
Cell["Steps 1 and 2: the integral over p, and the conditional of p", "Subsection"],
Cell["assume = a > 0 && b > 0 && m >= 0 && n >= 0;\n(* the kernel of the beta density times the Bernoulli terms; Mathematica combines the powers *)\nkernel = p^(a - 1) (1 - p)^(b - 1) p^m (1 - p)^n\nintegral = Integrate[kernel, {p, 0, 1}, Assumptions -> assume]/Beta[a, b];\ncheck[\"Step 2: integral over p equals B(a+K, b+T-1-K)/B(a,b)\",\n  FullSimplify[integral == Beta[a + m, b + n]/Beta[a, b], assume]]\ncheck[\"Step 2 (control): a wrong answer, B(a+K+1, b+T-1-K)/B(a,b), is rejected\",\n  !TrueQ[FullSimplify[integral == Beta[a + m + 1, b + n]/Beta[a, b], assume]]]\ncheck[\"Step 1: conditional of p is Beta(a+K, b+T-1-K)\",\n  FullSimplify[(kernel/Beta[a, b])/integral == PDF[BetaDistribution[a + m, b + n], p],\n    assume && 0 < p < 1]]", "Input"],
Cell["Step 3: the number of partitions, and the prior on the number of changes", "Subsection"],
Cell["partitions[T, l, l1] lists every partition of days 1..T whose first segment has at least l1 days and every other at least l, by the start days after day 1; count[T, l, l1, k] is the formula for the number with k changes (N_l(k) of Step 3 when l1 = l).", "Text"],
Cell["partitions[T_, l_, l1_] := Select[Subsets[Range[2, T]],\n  Function[s, With[{len = Differences[Join[{1}, s, {T + 1}]]},\n    First[len] >= l1 && AllTrue[Rest[len], Function[x, x >= l]]]]]\ncount[T_, l_, l1_, k_] := With[{r = T - l1 - l k}, If[r >= 0, Binomial[r + k, k], 0]]\npriorK[T_, l_, l1_, a_, b_] := With[{w = Table[count[T, l, l1, k] Beta[a + k, b + T - 1 - k], {k, 0, T - 1}]},\n  w/Total[w]]\nDo[With[{T = v[[1]], l = v[[2]], l1 = v[[3]]}, With[{found = partitions[T, l, l1]},\n   check[\"Step 3: number of partitions with k changes (T=\" <> ToString[T] <> \", l=\" <> ToString[l] <>\n     \", first >= \" <> ToString[l1] <> \")\",\n    AllTrue[Range[0, T - 1], Function[k, Count[found, s_ /; Length[s] == k] == count[T, l, l1, k]]]]]\n  ], {v, {{12, 1, 1}, {12, 2, 2}, {14, 3, 3}, {14, 3, 6}, {15, 2, 5}}}]\nDo[With[{T = v[[1]], l = v[[2]], l1 = v[[3]]}, With[{found = partitions[T, l, l1], a0 = 1, b0 = T},\n   With[{w = Beta[a0 + Length[#], b0 + T - 1 - Length[#]] & /@ found},\n    check[\"Step 3: Pr(K = k) against enumeration (T=\" <> ToString[T] <> \", l=\" <> ToString[l] <>\n      \", first >= \" <> ToString[l1] <> \", a=1, b=T)\",\n     Table[Total[Pick[w, Length /@ found, k]], {k, 0, T - 1}]/Total[w] == priorK[T, l, l1, a0, b0]]]]\n  ], {v, {{14, 3, 3}, {14, 3, 6}, {15, 2, 5}}}]", "Input"],
Cell["Table tab:changes", "Subsection"],
Cell["The prior on the number of changes for the fit to all reports (T = 157, a = 1, b = T), shown as in the table: two decimal places, or <0.01.", "Text"],
Cell["shown[x_] := If[x < 1/200, \"<0.01\", ToString[NumberForm[N[x], {Infinity, 2}]]]\ntabChanges = {\n   {\"R_t\", 7, 7, {\"0.57\", \"0.26\", \"0.11\", \"0.04\"}, \"0.02\", \"0.70\", 21},\n   {\"CFR_t\", 14, 14, {\"0.62\", \"0.26\", \"0.09\", \"0.02\"}, \"<0.01\", \"0.52\", 10},\n   {\"theta^C\", 14, 69, {\"0.78\", \"0.19\", \"0.03\", \"<0.01\"}, \"<0.01\", \"0.26\", 6},\n   {\"theta^D\", 14, 82, {\"0.82\", \"0.16\", \"0.02\", \"<0.01\"}, \"<0.01\", \"0.21\", 5}};\nDo[With[{row = tabChanges[[i]], pr = priorK[157, tabChanges[[i, 2]], tabChanges[[i, 3]], 1, 157]},\n   With[{computed = {shown /@ pr[[1 ;; 4]], shown[Total[pr[[5 ;;]]]],\n       ToString[NumberForm[N[Range[0, 156] . pr], {Infinity, 2}]],\n       Max[Flatten[Position[pr, x_ /; x != 0]]] - 1}},\n    check[\"Table tab:changes, row \" <> row[[1]] <> \": \" <> ToString[computed], computed == row[[4 ;;]]]]],\n  {i, Length[tabChanges]}]", "Input"],
Cell["A death which brings about the report", "Section"],
Cell["Appendix, \"What a report shows: one onset day\". Each fatal case has a delay to its report T_C and a time from onset to its death being recorded T_D, independent, and is of the triggered kind with probability tau; a triggered case is reported at Min[T_C, T_D], any other at T_C. The probabilities are checked by summing over every value of (kind, T_C, T_D), with symbolic probabilities for T_C = 0..5 and T_D = 1..6, for every pair of reports s < u.", "Text"],
Cell["pC = Append[Array[c, 5, 0], 1 - Total[Array[c, 5, 0]]];  (* Pr(T_C = 0..5) *)\npD = Append[Array[d, 5], 1 - Total[Array[d, 5]]];        (* Pr(T_D = 1..6) *)\ntC = Range[0, 5]; tD = Range[1, 6];\nSC[x_] := Total[Pick[pC, Thread[tC > x]]]\nSD[x_] := Total[Pick[pD, Thread[tD > x]]]\nreportedAt[kind_, tc_, td_] := If[kind == 1, Min[tc, td], tc]\nprob[event_] := Sum[If[event[kind, tC[[i]], tD[[j]]], If[kind == 1, tau, 1 - tau] pC[[i]] pD[[j]], 0],\n  {kind, 0, 1}, {i, Length[tC]}, {j, Length[tD]}]\nM[x_] := SC[x] ((1 - tau) + tau SD[x])\npairs = Select[Tuples[Range[0, 5], 2], #[[1]] < #[[2]] &];\nzeroQ[e_] := Simplify[Together[e]] === 0", "Input"],
Cell["check[\"Step 1: Pr(not reported by t') = S^C [(1 - tau) + tau S^D]\",\n  AllTrue[Range[0, 5], Function[s, zeroQ[prob[reportedAt[#1, #2, #3] > s &] - M[s]]]]]\ncheck[\"Step 2: Pr(new to report j and alive) = [S^C(t_{j-1}) - S^C(t_j)] S^D(t_j)\",\n  AllTrue[pairs, Function[su, With[{s = su[[1]], u = su[[2]]},\n    zeroQ[prob[s < reportedAt[#1, #2, #3] <= u && #3 > u &] - (SC[s] - SC[u]) SD[u]]]]]]\ncheck[\"Step 3: Pr(new) = M(t_{j-1}) - M(t_j), and Pr(dead | new) as given\",\n  AllTrue[pairs, Function[su, With[{s = su[[1]], u = su[[2]]},\n    With[{new = prob[s < reportedAt[#1, #2, #3] <= u &],\n          newDead = prob[s < reportedAt[#1, #2, #3] <= u && #3 <= u &]},\n     zeroQ[new - (M[s] - M[u])] &&\n      zeroQ[newDead/new - (1 - (SC[s] - SC[u]) SD[u]/(M[s] - M[u]))]]]]]]\ncheck[\"Deaths of cases shown as alive: 1 - S^D(t_j)/S^D(t_{j-1}) for either kind\",\n  AllTrue[Tuples[{pairs, {0, 1}}], Function[pk, With[{s = pk[[1, 1]], u = pk[[1, 2]], kind = pk[[2]]},\n    zeroQ[prob[#1 == kind && reportedAt[#1, #2, #3] <= s && #3 > s && #3 <= u &]/\n       prob[#1 == kind && reportedAt[#1, #2, #3] <= s && #3 > s &] - (1 - SD[u]/SD[s])]]]]]\ncheck[\"Step 2 (control): a wrong formula, without S^D(t_j), is rejected\",\n  !zeroQ[prob[1 < reportedAt[#1, #2, #3] <= 3 && #3 > 3 &] - (SC[1] - SC[3])]]", "Input"]
}]
